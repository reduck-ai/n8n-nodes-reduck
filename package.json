{
	"name": "@reduck-ai/n8n-nodes-reduck",
	"version": "0.1.0",
	"description": "Run your Reduck browser scripts in n8n workflows and AI agents.",
	"license": "MIT",
	"homepage": "https://github.com/reduck-ai/n8n-nodes-reduck#readme",
	"keywords": [
		"n8n-community-node-package",
		"reduck",
		"browser-automation",
		"web-automation",
		"scraping"
	],
	"author": {
		"name": "Reduck AI",
		"email": "support@reduck.ai",
		"url": "https://reduck.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/reduck-ai/n8n-nodes-reduck.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ReduckApi.credentials.js",
			"dist/credentials/ReduckOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Reduck/Reduck.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
