    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nlet pattern = null;\ntry { pattern = new RegExp(cfg.product_pattern, 'i'); } catch {}\nif (!pattern) throw new Error('Config: set product_pattern to a regular expression that captures the product id. Example: (?:dp|gp/product)/([A-Z0-9]{10})');\nif (!(Number(cfg.max_price) > 0)) throw new Error('Config: set max_price to the most you pay for one item. Example: 80');\nif (!(Number.isInteger(Number(cfg.quantity)) && Number(cfg.quantity) >= 1)) throw new Error('Config: set quantity to how many items to order. Example: 1');\nif (cfg.card_last4 && !/^\\d{4}$/.test(cfg.card_last4)) throw new Error('Config: set card_last4 to the last 4 digits of a card, or leave it empty for the default card of the account.');\nif (!/^https?:\\/\\//.test(cfg.notify_webhook ?? '')) throw new Error('Config: set notify_webhook to the URL that gets the result. Example: a Discord webhook URL.');\nreturn $input.all();"
      },
