    {
      "parameters": {
        "jsCode": "// One order for each product: a product with a row stops here, so two alerts for the same restock\n// do not order it twice. The row is written before the review, so an alert that comes while the\n// first one is still in the checkout stops too.\nconst { asin, alert } = $('Read Alert').first().json;\nif ($input.all().some((item) => item.json.asin === asin)) return [];\nreturn [{ json: { asin, claimed_at: $now.toISO(), alert } }];"
      },
      "id": "4fe3b7d3-8535-5c34-919a-584edcbe8f69",
      "name": "Skip If Ordered",
      "type": "n8n-nodes-base.code",
