    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Takes the product identifier out of the alert text with the Config pattern. No match: the run stops here.\nconst cfg = $('Config').first().json;\nconst text = $('Alert Webhook').first().json.body?.content ?? '';\nconst m = text.match(new RegExp(cfg.product_pattern, 'i'));\nif (!m) return [];\nreturn [{ json: { asin: (m[1] ?? m[0]).toUpperCase().trim(), alert: text } }];"
      },
