          "value": null
        },
        "options": {}
      },
      "id": "6c67a6bf-603a-54d3-88a9-4a9d2deab6d4",
      "name": "Claim The Product",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
