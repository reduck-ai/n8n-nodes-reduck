{
  "name": "Reduck: run one of your scripts from a webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reduck-page",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "fe35b689-1256-4e52-88b7-f4ffe11f0452"
    },
    {
      "parameters": {
        "resource": "script",
        "operation": "run",
        "script": {
          "__rl": true,
          "mode": "path",
          "value": "example.com/export_orders"
        },
        "scriptArguments": "={{ JSON.stringify($json.body ?? {}) }}",
        "waitForCompletion": true,
        "options": {
          "failOnScriptError": false
        }
      },
      "name": "Run Reduck script",
      "type": "n8n-nodes-reduck.reduck",
      "typeVersion": 1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: $json.status, result: $json.result, error: $json.error } }}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Run Reduck script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Reduck script": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
